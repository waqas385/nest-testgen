{
  "name": "@waqas385/nestjs-testgen",
  "version": "0.1.4",
  "description": "NestJS e2e test generator CLI: scaffold Jest + Supertest API tests from controllers and DTOs, with optional Jest wiring and CI-friendly output.",
  "author": "waqas385 <waqas385@gmail.com>",
  "homepage": "https://github.com/waqas385/nest-testgen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waqas385/nest-testgen.git"
  },
  "bugs": {
    "url": "https://github.com/waqas385/nest-testgen/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nestjs-testgen": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "generate": "npm run build && node dist/index.js"
  },
  "keywords": [
    "nestjs",
    "e2e",
    "e2e-testing",
    "integration-testing",
    "api-testing",
    "nestjs-testing",
    "test-generator",
    "jest-e2e",
    "supertest",
    "jest",
    "typescript",
    "cli",
    "dto",
    "endpoint-testing",
    "http-testing",
    "automated-testing"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^11.0.0",
    "glob": "^10.3.0",
    "ts-morph": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  }
}
